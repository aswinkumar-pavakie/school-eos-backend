# Supabase project settings -> Database -> Connection string
DATABASE_URL=
DIRECT_URL=

# Required. Signs/verifies access tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=

# Required. Supabase project settings -> API. SUPABASE_SERVICE_ROLE_KEY is a
# secret (bypasses Row Level Security) -- never expose it to a frontend/mobile
# client, only this backend reads it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional -- defaults shown. Bucket names in the Supabase project's Storage.
# SUPABASE_PHOTOS_BUCKET=person-photos
# SUPABASE_DOCUMENTS_BUCKET=documents

PORT=3000

# Optional — auth module defaults shown; uncomment to override.
# JWT_ACCESS_EXPIRES_IN=15m
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_MINUTES=15
# AUTH_REFRESH_TOKEN_TTL_DAYS=30
# AUTH_OTP_TTL_MINUTES=10

# Online Classes — Google OAuth (Phase 6). Not required to boot the app; only the
# /online-classes/google/connect and /callback routes need these. Create a "Web
# application" OAuth 2.0 Client ID in Google Cloud Console (enable the Google Calendar
# API first), with GOOGLE_OAUTH_REDIRECT_URI registered as an authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/online-classes/google/callback

# Encrypts the stored Google refresh token at rest (see encryption_key_id on
# google_account_connection — this is key version "v1"; rotate by adding a "v2" key
# and a matching branch in google-token-crypto.util.ts without needing a hard-coded key
# in source). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY_V1=

# Messaging — "Translate" feature (Google Cloud Translation v2 REST API). Not
# required to boot the app; only POST .../messages/:messageId/translate needs it.
# Enable the Cloud Translation API in Google Cloud Console and create an API key
# restricted to it. Left empty, translate requests fail with a clear
# "not configured" error rather than a fake translated result.
GOOGLE_TRANSLATE_API_KEY=
