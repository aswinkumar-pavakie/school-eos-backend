# Supabase project settings -> Database -> Connection string
DATABASE_URL=
DIRECT_URL=

# Required. Signs/verifies access tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=

# Required. Supabase project settings -> API. SUPABASE_SERVICE_ROLE_KEY is a
# secret (bypasses Row Level Security) -- never expose it to a frontend/mobile
# client, only this backend reads it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional -- defaults shown. Bucket names in the Supabase project's Storage.
# SUPABASE_PHOTOS_BUCKET=person-photos
# SUPABASE_DOCUMENTS_BUCKET=documents

PORT=3000

# Optional — auth module defaults shown; uncomment to override.
# JWT_ACCESS_EXPIRES_IN=15m
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_MINUTES=15
# AUTH_REFRESH_TOKEN_TTL_DAYS=30
# AUTH_OTP_TTL_MINUTES=10

# Required for the Parent app's fee payment feature. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINANCE_PAYMENT_WEBHOOK_SECRET=

# Required for the Parent app's Razorpay fee payment feature.
# Key Id/Secret: Razorpay Dashboard -> Settings -> API Keys (Test Mode to start).
# Webhook secret: whatever you set in Dashboard -> Settings -> Webhooks when adding
# this backend's /api/v1/parent/razorpay/webhook URL there.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
