# Supabase project settings -> Database -> Connection string
DATABASE_URL=
DIRECT_URL=

# Required. Signs/verifies access tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=

# Required. Supabase project settings -> API. SUPABASE_SERVICE_ROLE_KEY is a
# secret (bypasses Row Level Security) -- never expose it to a frontend/mobile
# client, only this backend reads it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional -- defaults shown. Bucket names in the Supabase project's Storage.
# SUPABASE_PHOTOS_BUCKET=person-photos
# SUPABASE_DOCUMENTS_BUCKET=documents

PORT=3000

# Optional — auth module defaults shown; uncomment to override.
# JWT_ACCESS_EXPIRES_IN=15m
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_MINUTES=15
# AUTH_REFRESH_TOKEN_TTL_DAYS=30
# AUTH_OTP_TTL_MINUTES=10
