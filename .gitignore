# ---- Dependencies ----
node_modules/

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Build / compiled output ----
dist/
build/
out/

# ---- Test coverage ----
coverage/
.nyc_output/

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- IDE / editor ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- Temporary files ----
tmp/
temp/
*.tmp

# ---- Prisma / local database artifacts ----
prisma/*.db
prisma/*.sqlite
prisma/*.sqlite3
prisma/dev.db*

# Compiled artifacts of prisma.config.ts -- if any tool ever emits these next to the
# source again, Prisma's CLI silently prefers the .js and can choke on a stale one.
prisma.config.js
prisma.config.js.map

# ---- Package manager ----
.pnpm-store/
query.md

# ---- User-uploaded files (local disk storage, see PersonsController photo endpoints) ----
uploads/*
!uploads/.gitkeep
API_REFERENCE.md
